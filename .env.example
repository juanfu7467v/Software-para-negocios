# Puerto HTTP (Fly.io inyecta PORT automáticamente)
PORT=8080
NODE_ENV=development
TZ=America/Lima

# Firebase Web: datos públicos del proyecto (Firebase Console > Configuración > Tus apps)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=

# Firebase Admin: usa FIREBASE_SERVICE_ACCOUNT (JSON en una sola línea) o las tres variables siguientes.
# En Fly.io es recomendable guardar el JSON como secret FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT=
# Alternativa a FIREBASE_SERVICE_ACCOUNT:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
