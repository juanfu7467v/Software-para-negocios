{
  "name": "tuturno",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma multinegocio de reservas por bloques de tiempo con Firebase y Express",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "check": "node --check index.js && node --check public/app.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^7.1.0",
    "multer": "^2.0.2"
  },
  "license": "MIT",
  "overrides": {
    "uuid": "^11.1.1"
  }
}
